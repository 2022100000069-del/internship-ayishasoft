# Copy this file to ".env" and fill in your own values.
# Never commit .env to GitHub (it is already in .gitignore).

PORT=3000

# The Gmail account that SENDS the summary emails
GMAIL_USER=your.address@gmail.com

# A 16-character Gmail App Password (NOT your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords
# (2-Step Verification must be turned on first). Spaces are fine.
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Where contact messages are delivered. Leave empty to send to GMAIL_USER.
CONTACT_TO=

# Time zone used for the "Received" time in the email
TIME_ZONE=Asia/Dhaka
